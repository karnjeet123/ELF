{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenBreweryDb": {
    "BaseUrl": "https://api.openbrewerydb.org/v1/",
    "PerPage": 200,
    "MaxPages": 5
  },
  "Cache": {
    "ExpirationMinutes": 10
  },
  "ConnectionStrings": {
    "BreweryDb": "Data Source=brewery.db"
  },
  "Jwt": {
    "Issuer": "elf.brewery.api",
    "Audience": "elf.brewery.client",
    "ExpiryMinutes": 60
  },
  "StaticUser": {
    "Username": "admin@elfbeauty.com"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://elf.beauty.com",
      "http://localhost:5214",
      "https://localhost:7239",
      "http://localhost:3000",
      "https://localhost:3000",
      "http://localhost:4200",
      "https://localhost:4200",
      "http://localhost:5173",
      "https://localhost:5173"
    ]
  },
  "RateLimiting": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "SegmentsPerWindow": 6
  },
  "AllowedHosts": "*"
}