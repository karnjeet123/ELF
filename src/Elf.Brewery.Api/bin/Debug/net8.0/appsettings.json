{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OpenBreweryDb": {
    "BaseUrl": "https://api.openbrewerydb.org/v1/",
    "PerPage": 200,
    "MaxPages": 5
  },
  "Cache": {
    "ExpirationMinutes": 10
  },
  "ConnectionStrings": {
    "BreweryDb": "Data Source=brewery.db"
  },
